# Gate 4 전 단일 환경 예시. 모든 항목은 optional이며, 등록하지 않아도 빌드된다.
# 검증 스키마: src/env.client.ts, src/env.server.ts
# NEXT_PUBLIC_*에는 비밀값을 넣지 않는다.

# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_LEGACY_BASE_URL=https://nonsul-learn.com
# NEXT_PUBLIC_LEGACY_ASSET_HOST=nonsul-learn.com
# NEXT_PUBLIC_VIEWER_SOURCE=mock
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# COURSE_SOURCE=mock
# LEGACY_BRIDGE_BASE=
# LEGACY_BRIDGE_TIMEOUT_MS=3000
# COURSE_REVALIDATE_SECONDS=300
# V2_PROXY_SECRET=

# VERCEL_URL=  # Vercel 자동 주입; metadataBase에만 선택적으로 사용
# VERCEL_GIT_COMMIT_SHA=  # Vercel 자동 주입; 진단 응답의 배포 식별자
