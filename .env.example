# 환경변수의 단일 진실은 이 파일이다 (docs/harness/GATES.md Gate 1).
# 검증 스키마: src/env.client.ts, src/env.server.ts
# 환경별 실제 값은 docs/runbook/vercel-setup.md 표를 따른다.
#
# 이 파일을 복사해 .env.local 로 쓴다. .env 와 .env*.local 은 커밋되지 않는다.
#   cp .env.example .env.local
#
# AGENTS.md §9: NEXT_PUBLIC_* 에 비밀값을 넣지 않는다.
# AGENTS.md §2: DB 접속 정보, PHP session secret, PG/SMTP/SMS credential 은
#               V2 환경변수가 아니다. 이 파일에 등장해서는 안 된다.

# ── client (브라우저 번들에 포함됨) ────────────────────────────────────────────
# canonical URL 과 metadataBase 의 기준. 운영은 메인 도메인.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy PHP origin. 빈 문자열이면 상대경로(same-origin)를 쓴다.
# 운영은 Apache 정문이 같은 도메인이므로 빈 문자열이 정답이다.
NEXT_PUBLIC_LEGACY_BASE_URL=

# Legacy 이미지 자산 hostname. scheme/경로/포트 없이 host 만.
NEXT_PUBLIC_LEGACY_ASSET_HOST=localhost

# mock | http — viewer 는 브라우저가 /v2-api/viewer.php 를 직접 호출한다.
NEXT_PUBLIC_VIEWER_SOURCE=mock

# true | false — false 면 track() 이 console 출력만 한다 (기본 false).
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── server (브라우저로 나가지 않음) ──────────────────────────────────────────
# mock | http — 강좌 공개 정보는 Vercel 서버가 ISR 로 가져온다.
COURSE_SOURCE=mock

# Thin PHP Bridge base. 끝에 / 를 붙이지 않는다.
LEGACY_BRIDGE_BASE=http://localhost:3000/v2-api

# 500 ~ 10000. 기본 3000.
LEGACY_BRIDGE_TIMEOUT_MS=3000

# 30 이상. 기본 300. 강좌 페이지 ISR 주기.
COURSE_REVALIDATE_SECONDS=300

# Apache 프록시가 붙이는 X-V2-Proxy-Secret 값. 최소 16자, production 은 32자 이상.
#   openssl rand -hex 32
V2_PROXY_SECRET=local-development-only-not-a-secret

# true | false — true 면 non-production 에서도 origin 보호를 강제한다 (기본 false).
V2_ENFORCE_PROXY=false

# development | preview | production. Vercel 이 자동 주입한다. 로컬 기본값은 development.
VERCEL_ENV=development

# ── Gate 5 (지금은 넣지 않는다) ──────────────────────────────────────────────
# 추적 ID(GTM/GA4/Meta/Naver/Kakao)와 NEXT_PUBLIC_ATTRIBUTION_COOKIE_DOMAIN 은
# Gate 5 에서 측정을 신규 도입할 때 추가한다.
# 근거: docs/discovery/tracking-inventory.md — 현재 Legacy 에 추적 태그 0건이므로
#       Gate 5 는 "추적 parity 유지"가 아니라 "측정 신규 도입"이다 (결정 #11).
