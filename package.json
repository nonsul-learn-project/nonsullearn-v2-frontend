{
  "name": "nonsullearn-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "check:legacy-css": "node scripts/verify-legacy-css.mjs",
    "contract:fixtures": "node scripts/bridge-check.mjs --fixtures",
    "bridge:check": "node scripts/bridge-check.mjs",
    "test:visual": "playwright test --project=visual",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "format": "prettier --write .",
    "check": "pnpm check:legacy-css && pnpm contract:fixtures && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "bootstrap": "5.3.2",
    "next": "16.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "24.12.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.0",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
