{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonsulrun.example/schemas/course-content.schema.json",
  "title": "Course template content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "templateType", "hero", "sections", "assets", "contentMetadata"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "courseId": { "type": "string", "pattern": "^(?:__default__|[A-Za-z0-9_-]{1,20})$" },
    "templateType": { "enum": ["humanities", "math", "short-answer"] },
    "hero": { "$ref": "#/$defs/hero" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "assets": { "$ref": "#/$defs/assets" },
    "instructor": { "$ref": "#/$defs/instructor" },
    "curriculum": { "$ref": "#/$defs/curriculum" },
    "proof": { "$ref": "#/$defs/proof" },
    "learningSystem": { "$ref": "#/$defs/learningSystem" },
    "faq": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/faq" } },
    "contentMetadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "hero": { "type": "object", "additionalProperties": false, "required": ["marketingHeadline", "highlight"], "properties": { "marketingHeadline": {"type":"string","minLength":1}, "highlight":{"type":"string","minLength":1}, "keywords":{"type":"string"}, "summary":{"type":"string"}, "target":{"type":"string"}, "ctaLabel":{"type":"string","minLength":1,"default":"수강 신청하기"} } },
    "section": { "type": "object", "additionalProperties": false, "required": ["id", "visible"], "properties": { "id": {"enum":["problem","outcomes","proof","method","curriculum","learning-system","recommend","course-info","community","enroll","faq","legacy-content"]}, "visible":{"type":"boolean"} } },
    "asset": { "type":"object", "additionalProperties":false, "required":["src","alt"], "properties":{"src":{"type":"string","pattern":"^(?:/|https://)"},"alt":{"type":"string","minLength":1}} },
    "assets": { "type":"object", "additionalProperties":false, "required":["productImagePolicy"], "properties":{"productImagePolicy":{"const":"legacy-gallery"},"instructorPhoto":{"$ref":"#/$defs/asset"},"previewVideoUrl":{"type":"string","format":"uri"},"certificates":{"type":"array","items":{"$ref":"#/$defs/asset"}}} },
    "instructor": {"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1},"introduction":{"type":"string","minLength":1},"careers":{"type":"array","maxItems":3,"items":{"type":"string","minLength":1}}}},
    "curriculum": {"type":"object","additionalProperties":false,"properties":{"introduction":{"type":"string","minLength":1},"lessons":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["title","description"],"properties":{"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"output":{"type":"string"},"check":{"type":"string"},"duration":{"type":"string"}}}}}},
    "proof": {"type":"object","additionalProperties":false,"properties":{"brandStats":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["value","label","basis"],"properties":{"value":{"type":"string"},"label":{"type":"string"},"basis":{"type":"string"}}}},"preservationScope":{"const":"brand-wide"}}},
    "learningSystem": {"type":"object","additionalProperties":false,"properties":{"methodLine":{"type":"string"},"promise":{"type":"string"},"steps":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["title","description"],"properties":{"title":{"type":"string"},"description":{"type":"string"}}}},"session":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["label","description"],"properties":{"label":{"type":"string"},"description":{"type":"string"}}}},"feedback":{"type":"object","additionalProperties":false,"required":["count","uploadGuide","returnGuide"],"properties":{"count":{"type":"integer","minimum":1},"uploadGuide":{"type":"string"},"returnGuide":{"type":"string"}}}}},
    "faq": {"type":"object","additionalProperties":false,"required":["question","answer"],"properties":{"question":{"type":"string","minLength":1},"answer":{"type":"string","minLength":1}}},
    "metadata": {"type":"object","additionalProperties":false,"required":["sourceDocuments","legacyHtml"],"properties":{"sourceDocuments":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"legacyHtml":{"enum":["visible","hidden"]},"reviewedAt":{"type":"string","format":"date"}}}
  }
}
