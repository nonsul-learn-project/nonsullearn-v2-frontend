{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "course-detail.v1",
  "description": "GET /v2-api/courses.php?id=<it_id> — 강좌 단건. 없는 id 는 404 + error.v1, 잘못된 id 는 400 + error.v1 이다. 즉 이 envelope 의 item 은 null 이 될 수 없다.",
  "type": "object",
  "required": ["v", "item"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "item": { "$ref": "#/$defs/course" }
  },
  "$defs": {
    "course": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "price",
        "listPrice",
        "priceOnInquiry",
        "soldOut",
        "image",
        "categoryId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,20}$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "price": { "type": "integer", "minimum": 0 },
        "listPrice": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "priceOnInquiry": { "type": "boolean" },
        "soldOut": { "type": "boolean" },
        "image": { "oneOf": [{ "type": "string", "pattern": "^/" }, { "type": "null" }] },
        "categoryId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
